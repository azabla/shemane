{
    "name": "liberusoftware/ecommerce-printful",
    "description": "Printful print-on-demand fulfilment and catalogue import for the Liberu ecommerce platform.",
    "type": "liberu-module",
    "version": "0.1.0",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "illuminate/console": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/support": "^13.0",
        "liberusoftware/ecommerce-contracts": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Liberu\\Ecommerce\\Printful\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Liberu\\Ecommerce\\Printful\\Tests\\": "tests/"
        }
    },
    "extra": {
        "liberu": {
            "name": "ecommerce-printful"
        }
    }
}
